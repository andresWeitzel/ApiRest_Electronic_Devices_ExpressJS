# ===========================================
# DATABASE (PostgreSQL)
# ===========================================

# Production (priority). On Render these come from render.yaml / Blueprint.
DB_NAME_PROD=
DB_USER_PROD=
DB_PASS_PROD=
DB_HOST_PROD=
DB_DIALECT_PROD=postgres
DB_PORT_PROD=5432
# true on Render Postgres; leave empty/false for local Docker
DB_SSL=

DB_POOL_MAX_PROD=5
DB_POOL_MIN_PROD=0
DB_POOL_ACQUIRE_PROD=30000
DB_POOL_IDLE_PROD=10000

# Local / Docker (used when *_PROD are empty)
DATABASE_NAME=dispositivos_electronicos
DATABASE_USER=dispositivos_user
DATABASE_PASSWORD=dispositivos_pass
DATABASE_HOST=localhost
DATABASE_DIALECT=postgres
DATABASE_PORT=5432

DATABASE_POOL_MAX=5
DATABASE_POOL_MIN=0
DATABASE_POOL_ACQUIRE=30000
DATABASE_POOL_IDLE=10000

# ===========================================
# APP
# ===========================================

# Render injects PORT. Local defaults to APP_PORT / PROD_PORT.
PROD_PORT=8082
APP_PORT=8082

# ===========================================
# API ROUTES
# ===========================================

API_LOCAL_BASE_URL=http://localhost:8082
API_COMPONENT_NAME_URL=/api/v1/componentes
API_COMPONENT_DETAIL_NAME_URL=/api/v1/componentes-detalles
API_BIPOLAR_TRANSISTOR_NAME_URL=/api/v1/transistores-bipolares
API_ELECTROLYTIC_CAPACITOR_NAME_URL=/api/v1/capacitores-electroliticos
API_MOSFET_TRANSISTOR_NAME_URL=/api/v1/transistores-mosfet
